{
  "name": "@kerneldreams/mcp",
  "version": "0.1.0",
  "description": "Agent hands on a machine: an installed host agent (file panel) and the agent tools over MCP Streamable HTTP in one bun binary.",
  "license": "MIT",
  "author": "Denys Vynohradskyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KernelDreams/kd.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "nr-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "build:bin": "node scripts/build-bin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@kerneldreams/chat-store": "0.1.0",
    "@kerneldreams/host-agent": "0.1.0",
    "@kerneldreams/tools": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "bun": "^1.3.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
