{
  "name": "@kerneldreams/runz-runtime",
  "version": "0.1.0",
  "description": "runz runtime: script and document loading, registry, context chain, resolve hook, providers and extension slots as files.",
  "license": "MIT",
  "author": "Denys Vynohradskyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KernelDreams/kd.git",
    "directory": "packages/runz-runtime"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./llm": {
      "types": "./dist/llm/index.d.ts",
      "default": "./dist/llm/index.js"
    },
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@kerneldreams/comfy-client": "0.1.0",
    "@kerneldreams/engine": "0.1.0",
    "@kerneldreams/nrd": "0.1.0",
    "nunjucks": "^3.2.4"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./llm": {
        "types": "./dist/llm/index.d.ts",
        "default": "./dist/llm/index.js"
      },
      "./web": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      }
    },
    "types": "./dist/index.d.ts",
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nunjucks": "^3.2.6",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
