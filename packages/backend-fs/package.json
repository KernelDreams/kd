{
  "name": "@kerneldreams/backend-fs",
  "version": "0.1.0",
  "description": "Workspace files on disk for the UI protocol: createFsWorkspace(root) with list/read/write/delete/rename/stat/watch/search, and mounted directories.",
  "license": "MIT",
  "author": "Denys Vynohradskyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KernelDreams/kd.git",
    "directory": "packages/backend-fs"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node -e \"const p=require('./package.json');const bad=Object.entries({...p.dependencies,...p.peerDependencies}).filter(([,v])=>String(v).startsWith('file:'));if(bad.length){console.error('publish blocked: file: deps '+bad.map(([k])=>k).join(', '));process.exit(1)}\""
  },
  "dependencies": {
    "@kerneldreams/ui-protocol": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
