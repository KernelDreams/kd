{
  "name": "@kerneldreams/artifacts",
  "version": "0.1.0",
  "description": "Artifacts runtime: manifest, collections, permissions, static checks, native esbuild JSX compile, init/finalize/revert lifecycle and the v2 bridge host (static HTTP, artifact services, runz runs, ComfyUI capability).",
  "license": "MIT",
  "author": "Denys Vynohradskyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KernelDreams/kd.git",
    "directory": "packages/artifacts"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "import": "./dist/host.js",
      "default": "./dist/host.js"
    },
    "./prelude.js": "./dist/assets/prelude.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json && node scripts/assets.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node -e \"const p=require('./package.json');const bad=Object.entries({...p.dependencies,...p.peerDependencies}).filter(([,v])=>String(v).startsWith('file:'));if(bad.length){console.error('publish blocked: file: deps '+bad.map(([k])=>k).join(', '));process.exit(1)}\""
  },
  "dependencies": {
    "@kerneldreams/comfy-client": "0.1.0",
    "@kerneldreams/nrd": "0.1.0",
    "@kerneldreams/runz-run": "0.1.0",
    "@kerneldreams/skins": "0.1.0",
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
