{
  "name": "@kerneldreams/plugins",
  "version": "0.1.0",
  "description": "Plugins by git link: lock file with pinned commit and rollback, read-only registry repos with a cascade of sources, manifests of all weights, Plugin API version ranges. Node, no dependencies besides git.",
  "license": "MIT",
  "author": "Denys Vynohradskyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KernelDreams/kd.git",
    "directory": "packages/plugins"
  },
  "keywords": [
    "nrchat",
    "plugins",
    "registry",
    "git",
    "zero-dependency"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./semver": {
      "types": "./dist/semver.d.ts",
      "import": "./dist/semver.js",
      "default": "./dist/semver.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
