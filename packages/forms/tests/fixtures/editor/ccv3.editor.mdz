$editor: 1
$id: ccv3
$title: Character Card V3

## $section card
$title: Карточка

### $field spec
$row: r1
$type: string
$label: Спецификация
$default: chara_card_v3

### $field spec_version
$row: r1
$type: string
$label: Версия спецификации
$default: "3.0"

### $field kind
$path: data.extensions.nrchat.kind
$type: string
$label: Вид
$enum: $[bot, persona]
$widget: select
$default: bot
$props: {labels: {bot: "Бот", persona: "Персона"}}

### $group data

#### $field name
$row: r2
$type: string
$label: Имя
$required: true

#### $field nickname
$row: r2
$type: string
$label: Прозвище

#### $field tags
$type: string[]
$label: Теги
$widget: tags

## $section character
$title: Персонаж

### $group data

#### $field description
$type: string
$label: Описание
$widget: textarea
$props: {rows: 8}

#### $field personality
$type: string
$label: Личность
$widget: textarea
$props: {rows: 4}

#### $field scenario
$type: string
$label: Сценарий
$widget: textarea
$props: {rows: 4}

## $section dialogue
$title: Диалог
$show-if: {"data.extensions.nrchat.kind": ["bot"]}

### $group data

#### $field first_mes
$type: string
$label: Первое сообщение
$widget: textarea
$props: {rows: 8}

#### $field alternate_greetings
$type: string[]
$label: Альтернативные приветствия
$widget: ccv3.greetings

#### $field group_only_greetings
$type: string[]
$label: Приветствия только для группы
$widget: ccv3.greetings

#### $field mes_example
$type: string
$label: Примеры диалога
$widget: textarea
$props: {rows: 8}

## $section prompts
$title: Промпты
$collapsed: true

### $group data

#### $field system_prompt
$type: string
$label: Системный промпт
$widget: textarea
$props: {rows: 4}

#### $field post_history_instructions
$type: string
$label: Инструкции после истории
$widget: textarea
$props: {rows: 4}

## $section lorebook
$title: Лорбук
$collapsed: true

### $group data

#### $group character_book

##### $field name
$type: string
$label: Название лорбука

##### $field scan_depth
$row: r3
$type: integer
$label: Глубина сканирования
$min: 0
$props: {min: 0}

##### $field token_budget
$row: r3
$type: integer
$label: Бюджет токенов
$min: 0
$props: {min: 0}

##### $field recursive_scanning
$row: r3
$type: boolean
$label: Рекурсивное сканирование

##### $repeat entries
$label: Записи
$item-title: name

###### $field keys
$type: string[]
$label: Ключи
$widget: ccv3.lorebook-keys

###### $field content
$type: string
$label: Содержание
$widget: textarea
$props: {rows: 6}

###### $field enabled
$type: boolean
$label: Включена
$default: true

###### $field insertion_order
$type: integer
$label: Порядок вставки
$default: 100

###### $field case_sensitive
$type: boolean
$label: С учётом регистра

###### $field name
$type: string
$label: Имя записи

###### $field priority
$type: integer
$label: Приоритет

###### $field comment
$type: string
$label: Комментарий

## $section assets
$title: Ассеты
$collapsed: true

### $group data

#### $repeat assets
$label: Ассеты
$item-title: name

##### $field type
$row: r4
$type: string
$label: Тип
$default: icon

##### $field name
$row: r4
$type: string
$label: Имя

##### $field ext
$row: r4
$type: string
$label: Расширение

##### $field uri
$type: string
$label: URI
$widget: image

## $section meta
$title: Автор и служебное
$collapsed: true

### $group data

#### $field creator
$row: r5
$type: string
$label: Автор

#### $field character_version
$row: r5
$type: string
$label: Версия персонажа

#### $field creator_notes
$type: string
$label: Заметки автора
$widget: textarea
$props: {rows: 4}

#### $field extensions
$type: object
$label: Расширения
$widget: json
