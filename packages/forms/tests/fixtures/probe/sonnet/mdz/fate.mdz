## $section stunts
$title: Трюки

### $repeat stunts
$label: Трюки
$item-title: name

#### $field name
$type: string
$label: Название

#### $field description
$type: string
$label: Описание
$widget: textarea
$props: {rows: 3}

## $section stress
$title: Стресс и последствия

### $computed physicalBoxes
$label: Ячеек физического
$expr: "<< 3 + (1 if skills.physique >= 1 else 0) + (1 if skills.physique >= 3 else 0) >>"
$type: number

### $computed mentalBoxes
$label: Ячеек ментального
$expr: "<< 3 + (1 if skills.will >= 1 else 0) + (1 if skills.will >= 3 else 0) >>"
$type: number

### $field physical
$path: stress.physical
$type: boolean[]
$label: Физический
$widget: fate.stress-track
$props: {boxes: "=physicalBoxes"}

### $field mental
$path: stress.mental
$type: boolean[]
$label: Ментальный
$widget: fate.stress-track
$props: {boxes: "=mentalBoxes"}

### $field mild
$path: consequences.mild
$type: string
$label: Лёгкое
$widget: fate.consequence
$props: {severity: "mild", value: 2}

### $field moderate
$path: consequences.moderate
$type: string
$label: Среднее
$widget: fate.consequence
$props: {severity: "moderate", value: 4}

### $field severe
$path: consequences.severe
$type: string
$label: Тяжёлое
$widget: fate.consequence
$props: {severity: "severe", value: 6}
