$editor: 1
$id: fate
$title: Fate Condensed

## $section character
$title: Персонаж

### $field portrait
$row: r1
$type: string
$label: Портрет
$widget: image
$props: {aspect: "2:3"}

### $field name
$row: r1
$type: string
$label: Имя
$required: true

### $field description
$type: string
$label: Описание
$widget: textarea
$props: {rows: 4}

### $field refresh
$row: r2
$type: integer
$label: Восстановление
$min: 0
$default: 3

### $field fatePoints
$row: r2
$type: integer
$label: Жетоны судьбы
$widget: fate.fate-points
$min: 0
$default: 3
$props: {refreshFrom: "refresh"}

## $section aspects
$title: Аспекты

### $field highConcept
$type: string
$label: Концепция
$widget: fate.aspect
$props: {kind: "high-concept"}

### $field trouble
$type: string
$label: Проблема
$widget: fate.aspect
$props: {kind: "trouble"}

### $repeat aspects
$label: Другие аспекты
$item-title: text

#### $field text
$type: string
$label: Аспект
$widget: fate.aspect
$props: {kind: "other"}

