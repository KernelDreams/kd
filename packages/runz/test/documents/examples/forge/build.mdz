## $action trace
```ts
export default async function (ctx, meta, helpers) {
  return { output: [
    'bot.name    : ' + String(ctx.get(['bot', 'name'])),
    'bot.age     : ' + String(ctx.get(['bot', 'age'])),
    'bot.traits  : ' + String(ctx.get(['bot', 'traits'])),
    'bot.style   : ' + String(ctx.get(['bot', 'style'])),
    'bot.setting : ' + String(ctx.get(['bot', 'setting'])),
  ].join('\n') }
}
```
