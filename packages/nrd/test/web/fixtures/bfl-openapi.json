                      "$ref": "#/components/schemas/AsyncResponse"
                    },
                    {
                      "$ref": "#/components/schemas/AsyncWebhookResponse"
                    }
                  ],
                  "title": "Response Generate Flux 2 Pro V1 Flux 2 Pro Post"
                }
              }
            }
          }
        },
        "summary": "Generate or edit an image with FLUX.2 [pro]"
      }
    },
    "/v1/flux-pro-1.1": {
