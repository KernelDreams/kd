{
  "name": "@kerneldreams/editor",
  "version": "0.1.0",
  "description": "Text editor on CodeMirror 6: markdown live preview, mdz/mdd/mds syntax, code modes with a lazy TypeScript service.",
  "license": "MIT",
  "author": "Denys Vynohradskyi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KernelDreams/kd.git",
    "directory": "packages/editor"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "demo": "vite --config demo/vite.config.ts",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/check-bundle.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "screens": "node scripts/screens.mjs"
  },
  "dependencies": {
    "@atomic-editor/editor": "^0.6.2",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/merge": "^6.12.3",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/common": "^1.5.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@typescript/vfs": "^1.6.5",
    "@valtown/codemirror-ts": "^2.3.1",
    "comlink": "^4.4.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "private": false,
  "publishConfig": {
    "access": "public"
  }
}
